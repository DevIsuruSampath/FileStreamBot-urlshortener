# API service env example
# Domain served by this API service
PUBLIC_API_HOST=api.example.com

# App domains (used by resolve/host rules)
PUBLIC_WEB_HOST=exa.com
PUBLIC_CONTENT_HOST=adsexample.com
PUBLIC_ADMIN_HOST=admin.example.com

# Runtime
API_PORT=8000

# Database / cache
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/shortener
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change_me_super_secret
JWT_EXPIRE_MINUTES=10080

# First boot admin
DEFAULT_ADMIN_EMAIL=admin@changeme.com
DEFAULT_ADMIN_PASSWORD=changeme

# CORS (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
